# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: NCBI E-utilities key + contact email (raises PubMed rate limit to 10 req/s)
BIOMED_NCBI_API_KEY=
BIOMED_NCBI_EMAIL=

# Optional overrides (defaults shown)
# BIOMED_LLM_MODEL=claude-opus-5-5
# BIOMED_JUDGE_MODEL=claude-sonnet-5-5
# BIOMED_ANSWER_EFFORT=high
# BIOMED_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# BIOMED_TOP_K=12

# Optional: Langfuse tracing (install with `uv sync --extra tracing`)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
