# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: NCBI E-utilities key + contact email (raises PubMed rate limit to 10 req/s)
BIOMED_NCBI_API_KEY=
BIOMED_NCBI_EMAIL=

# Optional overrides (defaults shown)
# BIOMED_LLM_MODEL=claude-opus-5-5
# BIOMED_JUDGE_MODEL=claude-sonnet-5-5
# BIOMED_ANSWER_EFFORT=high
# BIOMED_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# BIOMED_TOP_K=12

# Optional: Langfuse tracing (installed by `uv sync --all-extras` or `--extra tracing`).
# Keys: Langfuse project -> Settings -> API Keys. BASE_URL must match your project's region:
#   EU https://cloud.langfuse.com · US https://us.cloud.langfuse.com · or your self-hosted URL
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Separates traffic in Langfuse dashboards. Evals always use "eval".
LANGFUSE_TRACING_ENVIRONMENT=development
# Redact emails, phone numbers, SSNs, MRNs, and dates of birth before traces leave the app.
# BIOMED_TRACE_MASK_PII=true
